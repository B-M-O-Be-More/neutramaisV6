# === Públicas (expostas ao browser, prefixo NEXT_PUBLIC_) ===
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no bundle durante o `npm run
# build`, não lidas em runtime. Defini-las só no ambiente do container/serviço
# não surte efeito — precisam estar presentes no momento do build.

# URL pública desta aplicação (o front: links absolutos, redirects de
# OAuth/email). NÃO é a URL das APIs — essa é a API_BASE_URL, mais abaixo.
# Ainda não é consumida pelo código; mantida para os fluxos que virão.
NEXT_PUBLIC_APP_URL=https://hom.neutramais.com

# Site key do hCaptcha — o UUID emitido no painel do hCaptcha
# (dashboard.hcaptcha.com → Sites), algo como
# 10000000-ffff-ffff-ffff-000000000001. NÃO é uma URL: o widget monta
# https://hcaptcha.com/getcaptcha/<site key>, então qualquer outro valor
# devolve 404 e o desafio não carrega.
# O login exige o desafio a partir da 3ª tentativa falha (identity-api
# /auth/login). Sem esta variável o widget não é renderizado e o envio não é
# bloqueado — útil em dev, mas em produção o upstream vai recusar.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Token público do Mapbox (pk.*) para os mapas de cobertura. Restrinja-o às
# URLs da aplicação no painel do Mapbox. Sem ele, o mapa mostra um aviso no
# lugar do mapa base.
NEXT_PUBLIC_MAPBOX_TOKEN=

# === Privadas (apenas server-side, NUNCA prefixo NEXT_PUBLIC_) ===
# Host das APIs da Neutra+, consumidas pelos route handlers BFF (app/api/*).
# O browser NUNCA fala com as APIs direto — sempre via /api (ADR-002). Lida em
# runtime: a mesma imagem serve homologação e produção.
# Só o host; o caminho e a versão de cada serviço ficam no código
# (src/server/apiBaseUrl.ts):
#   identity    → /identity/api/v1     (contas, sessão, KYC, convites)
#   marketplace → /marketplace/api/v2  (TMF620 Product Catalog)
#   compliance  → /compliance/api/v1   (revisão de KYC do painel admin)
#   geo         → /geo/api/v2          (cobertura/KMZ)
#   wallet      → /wallet/api/v2       (saldo e extrato da carteira)
API_BASE_URL=https://hom-api.neutramais.com

# Opcional: URL completa de um serviço, que vence a API_BASE_URL — ex.: rodar
# a geo-api localmente e o resto na homologação. Sem barra final.
# IDENTITY_API_URL=http://localhost:8001/identity/api/v1
# MARKETPLACE_API_URL=http://localhost:8002/marketplace/api/v2
# COMPLIANCE_API_URL=http://localhost:8003/compliance/api/v1
# GEO_API_URL=http://localhost:8004/geo/api/v2
# WALLET_API_URL=http://localhost:8005/wallet/api/v2

# Segredo para assinar/ler cookies internos do BFF (quando aplicável).
COOKIE_SECRET=
