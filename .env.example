# === Públicas (expostas ao browser, prefixo NEXT_PUBLIC_) ===
# ATENÇÃO: variáveis NEXT_PUBLIC_* são embutidas no bundle durante o `npm run
# build`, não lidas em runtime. Defini-las só no ambiente do container/serviço
# não surte efeito — precisam estar presentes no momento do build.

# URL pública desta aplicação (links absolutos, redirects de OAuth/email).
# NÃO é a URL da identity-api — essa é a IDENTITY_API_URL, mais abaixo.
# Ainda não é consumida pelo código; mantida para os fluxos que virão.
NEXT_PUBLIC_APP_URL=https://hom.neutramais.com

# Site key do hCaptcha — o UUID emitido no painel do hCaptcha
# (dashboard.hcaptcha.com → Sites), algo como
# 10000000-ffff-ffff-ffff-000000000001. NÃO é uma URL: o widget monta
# https://hcaptcha.com/getcaptcha/<site key>, então qualquer outro valor
# devolve 404 e o desafio não carrega.
# O login exige o desafio a partir da 3ª tentativa falha (identity-api
# /auth/login). Sem esta variável o widget não é renderizado e o envio não é
# bloqueado — útil em dev, mas em produção o upstream vai recusar.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# === Privadas (apenas server-side, NUNCA prefixo NEXT_PUBLIC_) ===
# Base URL da identity-api consumida pelos route handlers BFF (app/api/*).
# O browser NUNCA fala com esta URL direto — sempre via /api (ADR-002).
# Sem barra final (os paths do BFF começam com "/").
IDENTITY_API_URL=https://hom-api.neutramais.com/identity/api/v1

# Base URL da marketplace-api (TMF620 Product Catalog) consumida pelos route
# handlers BFF (app/api/productCatalog/*). Mesma regra: nunca exposta ao browser.
# Sem barra final. Contrato em <base sem /api/v2>/openapi.json.
MARKETPLACE_API_URL=https://hom-api.neutramais.com/marketplace/api/v2

# Segredo para assinar/ler cookies internos do BFF (quando aplicável).
COOKIE_SECRET=
